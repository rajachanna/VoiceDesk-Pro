# MUST replace with an independent high-entropy secret before running.
VD_OPERATOR_KEY=REPLACE_WITH_32_CHARACTER_RANDOM_OPERATOR_KEY
VD_DB_PATH=./data/voicedesk.sqlite
VD_BUSINESS_NAME=Northstar Demo Studio
VD_TIMEZONE=America/New_York

# Simulated frontend. Do not expose local demo publicly.
VD_DEMO_MODE=true

# Real telephony is OFF unless BOTH fields are configured and signed Twilio calls arrive.
# Set a public HTTPS URL, without a trailing slash (and with no path).
VD_TWILIO_AUTH_TOKEN=
VD_PUBLIC_BASE_URL=

# Optional FAQ LLM. Disabled by default; business facts only (no sensitive customer data).
VD_OPENAI_API_KEY=
VD_OPENAI_MODEL=gpt-4.1-mini
